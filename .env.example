# Local development uses Vite's /api proxy.
# Production example: https://api.your-domain.com/api
VITE_API_BASE_URL=/api

# Optional local development proxy for a deployed API.
# VITE_API_PROXY_TARGET=https://mobile.devapihub.cloud/vzom

# Optional production WebRTC ICE configuration. Use your own TURN service for reliable calls.
# VITE_ICE_SERVERS=[{"urls":"turn:turn.your-domain.com:3478","username":"user","credential":"password"}]
