# API server
# Use NODE_ENV=production on Hostinger.
NODE_ENV=development
# Local only. Do not include PORT in the production .env; production defaults to 3000 unless Hostinger provides PORT.
PORT=8011
MONGODB_URI=mongodb://127.0.0.1:27017/react-meet
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# Production: use only your deployed web origin and the native origins you actually ship.
# Keep localhost origins in a separate development/staging environment.
CLIENT_ORIGIN=https://your-frontend-domain.com,capacitor://localhost,http://localhost
DUMMYJSON_API_URL=https://dummyjson.com
COOKIE_SECURE=false
# Set to none when frontend and API are on different origins. Requires HTTPS and COOKIE_SECURE=true.
COOKIE_SAME_SITE=lax
APP_URL=http://localhost:5173/meetv1

# Hostinger SMTP (required in production)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@your-domain.com
SMTP_PASS=your-hostinger-mailbox-password
MAIL_FROM="React Meet <no-reply@your-domain.com>"
